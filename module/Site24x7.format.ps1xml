<?xml version="1.0" encoding="utf-8"?>
<!-- Default table views for the objects the Site24x7 cmdlets return. Every property is still there; use Format-List * to see them all. -->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Site24x7.Monitor</Name>
      <ViewSelectedBy><TypeName>Site24x7.Monitor</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>DisplayName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>State</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>MonitorId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>display_name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>state</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>monitor_id</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Site24x7.Group</Name>
      <ViewSelectedBy><TypeName>Site24x7.Group</TypeName><TypeName>Site24x7.Subgroup</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>DisplayName</Label></TableColumnHeader>
          <TableColumnHeader><Label>GroupId</Label></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>display_name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>group_id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>description</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Site24x7.User</Name>
      <ViewSelectedBy><TypeName>Site24x7.User</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>DisplayName</Label></TableColumnHeader>
          <TableColumnHeader><Label>EmailAddress</Label></TableColumnHeader>
          <TableColumnHeader><Label>Role</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>UserId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>display_name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>email_address</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>user_role</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>user_id</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Site24x7.UserGroup</Name>
      <ViewSelectedBy><TypeName>Site24x7.UserGroup</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>DisplayName</Label></TableColumnHeader>
          <TableColumnHeader><Label>UserGroupId</Label></TableColumnHeader>
          <TableColumnHeader><Label>Users</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>display_name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>user_group_id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>users</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Site24x7.Tag</Name>
      <ViewSelectedBy><TypeName>Site24x7.Tag</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>TagName</Label></TableColumnHeader>
          <TableColumnHeader><Label>TagValue</Label></TableColumnHeader>
          <TableColumnHeader><Label>TagId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>tag_name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>tag_value</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>tag_id</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Site24x7.Maintenance</Name>
      <ViewSelectedBy><TypeName>Site24x7.Maintenance</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>DisplayName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Start</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>End</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>MaintenanceId</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>display_name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>maintenance_type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>start_time</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>end_time</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>maintenance_id</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
